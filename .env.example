PORT=8787
NODE_ENV=development
# json = zero-cost local storage; postgres = Neon/PostgreSQL
LVSP_STORAGE=json
# demo = no-login development headers; local = signed staging login; oidc = production target
AUTH_MODE=local
LVSP_AUTH_SECRET=replace-with-a-long-random-secret
LVSP_BOOTSTRAP_ADMIN_USER=admin
LVSP_BOOTSTRAP_ADMIN_PASSWORD=change-this-password
# Neon pooled URL for application runtime
DATABASE_URL=
# Neon direct URL for schema migrations
DATABASE_URL_DIRECT=
DB_POOL_MAX=5
