# Configure these in Vercel project Environment Variables (Preview and Production).
NODE_ENV=production
AUTH_MODE=database
LVSP_STORAGE=postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full
LVSP_AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
DB_POOL_MAX=3
# For local reviewed migrations only, use the direct Neon endpoint:
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=verify-full

# Optional dossier AI. Leave disabled until provider/data handling is approved.
LVSP_AI_PROVIDER=gemini
LVSP_AI_MODEL=
OPENAI_API_KEY=

# Private document object storage (server only, least-privilege credentials).
LVSP_INTAKE_S3_BUCKET=
LVSP_INTAKE_S3_PRIVATE_CONFIRMED=false
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Gemini API credential: server only; never use the Gmail password.
GEMINI_API_KEY=

# Optional Neon private S3-compatible storage (instead of AWS S3).
# Set LVSP_INTAKE_STORAGE=neon-s3, then use the verified branch endpoint.
# AWS_ENDPOINT_URL_S3=https://br-...storage.c-5.us-east-2.aws.neon.tech
# AWS_ACCESS_KEY_ID= (Neon storage credential token_id; server secret)
# AWS_SECRET_ACCESS_KEY= (Neon s3_secret_access_key; server secret)
# The existing private-bucket confirmation and bucket settings remain required.
